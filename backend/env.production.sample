# Production env for EC2 — copy to backend/.env on the server and fill secrets.
# Local dev still uses PORT=8080 (see env.sample).

NODE_ENV=production
PORT=8085
APP_NAME=Lucky Winners Backend
TRUST_PROXY=2

USER_BACKEND_URL=https://luckywinners.bet
USER_FRONTEND_URL=https://luckywinners.bet
FRONTEND_URL=https://luckywinners.bet
BACKEND_PUBLIC_URL=https://luckywinners.bet
ALLOWED_ORIGIN=https://luckywinners.bet,https://www.luckywinners.bet,https://admin.luckywinners.bet

ADMIN_HOST_STORE_MAP=admin.luckywinners.bet:dragonfury
PUBLIC_HOST_STORE_MAP=luckywinners.bet:dragonfury,www.luckywinners.bet:dragonfury
# ENFORCE_STORE_ORIGIN_BINDING=true
# ENFORCE_ADMIN_HOST_BINDING=true

# Database
DB_PORT=5432
DB_WRITE_HOST=
DB_READ_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SYNC=false
# DB_SSL=true

JWT_LOGIN_SECRET=
JWT_LOGIN_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRY=30d

EMAIL_FROM=noreply@luckywinners.bet
EMAIL_SENDER_EMAIL=noreply@luckywinners.bet
EMAIL_SENDER_NAME=Lucky Winners
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

DRAGONFURY_FRONTEND_URL=https://luckywinners.bet
DRAGONFURY_MAIL_FROM=no-reply@luckywinners.bet
DRAGONFURY_MAIL_FROM_NAME=Lucky Winners
