-    const err = new Error('GitSlotPark is not configured');
-    err.statusCode = 503;
-    throw err;
-  }
-
-  const key = cacheKey(req);
-  const cached = cacheByKey.get(key);
-  if (cached?.data) {
-    if (Date.now() - cached.at >= CACHE_TTL_MS) {
-      loadGamesList(req, key).catch(() => {});
-    }
-    return cached.data;
-  }
-
-  try {
-    return await loadGamesList(req, key);
